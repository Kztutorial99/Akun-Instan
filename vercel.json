{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/orders.js": {
      "maxDuration": 60
    },
    "api/topup.js": {
      "maxDuration": 60
    },
    "api/assistant.js": {
      "maxDuration": 60
    },
    "api/admin/youtube.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/youtube/callback",
      "destination": "/api/admin/youtube?resource=callback"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/data?resource=sitemap"
    },
    {
      "source": "/api/stream",
      "destination": "/api/topup?resource=stream"
    },
    {
      "source": "/api/products",
      "destination": "/api/data"
    },
    {
      "source": "/api/catalog",
      "destination": "/api/data"
    },
    {
      "source": "/api/custom-email",
      "destination": "/api/orders?resource=check-email"
    },
    {
      "source": "/api/notifications",
      "destination": "/api/topup?resource=notifications"
    },
    {
      "source": "/api/callback/wijayapay",
      "destination": "/api/topup?resource=callback"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/account",
      "destination": "/"
    },
    {
      "source": "/topup",
      "destination": "/"
    },
    {
      "source": "/orders",
      "destination": "/"
    },
    {
      "source": "/katalog",
      "destination": "/_seo/katalog.html"
    },
    {
      "source": "/custom-email",
      "destination": "/_seo/custom-email.html"
    },
    {
      "source": "/help",
      "destination": "/_seo/help.html"
    },
    {
      "source": "/faq",
      "destination": "/_seo/faq.html"
    },
    {
      "source": "/cara-beli",
      "destination": "/_seo/cara-beli.html"
    },
    {
      "source": "/produk/gmail-fresh",
      "destination": "/_seo/produk-gmail-fresh.html"
    },
    {
      "source": "/produk/custom-gmail",
      "destination": "/_seo/produk-custom-gmail.html"
    },
    {
      "source": "/produk/gmail-aged",
      "destination": "/_seo/produk-gmail-aged.html"
    },
    {
      "source": "/produk/akun-game",
      "destination": "/_seo/produk-akun-game.html"
    },
    {
      "source": "/produk/akun-social-media",
      "destination": "/_seo/produk-akun-social-media.html"
    },
    {
      "source": "/terms",
      "destination": "/_seo/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/_seo/privacy.html"
    },
    {
      "source": "/refund",
      "destination": "/_seo/refund.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/_seo/disclaimer.html"
    },
    {
      "source": "/((?!api/|assets/)[^.]*)",
      "destination": "/"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
